# 复制为 .env 后按需修改
APP_NAME=MiniMall
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# 数据库连接（示例，替换为真实凭据；.env 不入库）
DB_URL=mysql+pymysql://user:password@127.0.0.1:3306/minimall_dev?charset=utf8mb4

# JWT 鉴权（生产必须使用强随机密钥）
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
